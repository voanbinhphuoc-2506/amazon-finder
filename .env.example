# Copy to .env.local (never commit secrets)
RAINFOREST_API_KEY=

# Landing grid (Mother's Day): run `python scripts/amazon_rainforest_search.py` to fill data/products.json (see script --cache-hours).

# Upstash Redis (optional) — search result cache 24h in /api/search (REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Outbound listing links from /api/search use Associates tag anvopro-20 (see AFFILIATE_TAG in app/api/search/route.ts).

# Canonical site URL for sitemap, robots, Open Graph (no trailing slash recommended)
NEXT_PUBLIC_SITE_URL=https://amazon-finder.vercel.app

# Required for production (footer, legal pages, JSON-LD): your public brand + inbox
NEXT_PUBLIC_COMPANY_NAME=SmartWorkHacks
NEXT_PUBLIC_SUPPORT_EMAIL=you@yourdomain.com

# Optional: load only after cookie Accept (see CookieConsent.tsx)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Optional: POST JSON { email, source } when someone joins waitlist
WAITLIST_WEBHOOK_URL=
